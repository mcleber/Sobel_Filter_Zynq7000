# ===============================
# Default behavior
# ===============================

# Automatically detect text files and normalize them to LF in the repository.
* text=auto eol=lf

# ===============================
# Git files
# ===============================

.gitattributes  text
.gitignore      text
.editorconfig   text

# ===============================
# Documentation
# ===============================

*.md            text eol=lf
*.txt           text eol=lf

# ===============================
# C / C++
# ===============================

*.c             text eol=lf
*.cpp           text eol=lf
*.h             text eol=lf
*.hpp           text eol=lf


# ===============================
# Python
# ===============================

*.py            text eol=lf

# ===============================
# Verilog / SystemVerilog
# ===============================

*.v             text eol=lf
*.vh            text eol=lf

# ===============================
# Build systems
# ===============================

Makefile        text eol=lf
*.mk            text eol=lf

# ===============================
# Images
# ===============================

*.png           binary

